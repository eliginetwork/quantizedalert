# Copy-paste this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- QuantizedAlert platform ---
QUANTIZEDALERT_QLIB_URI=~/.qlib/qlib_data/cn_data
DSA_PATH=./repos/daily_stock_analysis
QLIB_PATH=./repos/qlib
QUANTIZEDALERT_PORT=8765
QUANTIZEDALERT_LOG=INFO
QUANTIZEDALERT_DRY_RUN=0
# Optional database path override (default: data/quantizedalert.db):
# QUANTIZEDALERT_DB_PATH=data/quantizedalert.db
# Optional database URL for Cloud / Postgres migrations:
# DATABASE_URL=postgresql://user:pass@host:5432/quantizedalert
# Optional: Allow training on static/offline data dumps without staleness rejection:
# QUANTIZEDALERT_ALLOW_STALE=1
# Note: UNLOCKAID_* variable names remain supported for backward compatibility.

# --- LLM configuration (OpenAI-compatible endpoint) ---
# Optional: used by `quantizedalert explain` for research explanation prose polish.
# If unset, QuantizedAlert uses built-in deterministic templates [engine_source=template].
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Ollama, vLLM, Groq, OpenRouter).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Aliases also supported:
# QUANTIZEDALERT_LLM_MODEL=
# QUANTIZEDALERT_LLM_API_KEY=
# QUANTIZEDALERT_LLM_BASE_URL=
# (Legacy UNLOCKAID_LLM_* also supported)
# Examples:
#   OpenAI:   OPENAI_BASE_URL=https://api.openai.com/v1          OPENAI_MODEL=gpt-4o-mini     OPENAI_API_KEY=sk-...
#   DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1        OPENAI_MODEL=deepseek-chat   OPENAI_API_KEY=sk-...
#   Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1          OPENAI_MODEL=llama3.1:8b     OPENAI_API_KEY=ollama
#   vLLM:     OPENAI_BASE_URL=http://localhost:8000/v1           OPENAI_MODEL=qwen2.5-coder   OPENAI_API_KEY=none

# --- Dashboard auth (set to enable; unset = open in dev) ---
QUANTIZEDALERT_DASHBOARD_TOKEN=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# JSON object mapping plan -> Stripe price ID:
QUANTIZEDALERT_STRIPE_PRICES={"individual":"price_xxx","professional":"price_yyy","team":"price_zzz"}

# --- Alert channels (DSA contract — set per channel you use) ---
CUSTOM_WEBHOOK_URLS=https://hook.example/x
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
MAIL_SENDER=
MAIL_PASSWORD=
MAIL_RECEIVERS=
FEISHU_WEBHOOK_URL=
WECHAT_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# --- Misc ---
MLFLOW_DISABLE_AGENT_HINT=1
